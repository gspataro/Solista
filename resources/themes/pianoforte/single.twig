{%extends './layout.twig'%}
{%block body%}
    {%if related('categories')%}
        <ul class="flex gap-4 mb-4">
            {%for category in related('categories')%}
                <li>
                    <a href="{{url(category.tag)}}">
                        {{category.metadata.title}}
                    </a>
                </li>
            {%endfor%}
        </ul>
    {%endif%}
    <h1 class="mb-4">
        {{post.metadata.title}}
    </h1>
    <p class="text-2xl mb-14">
        {{post.metadata.description}}
    </p>
    <div class="prose">
        {{post.body|orchestra_content}}
    </div>
{%endblock%}
